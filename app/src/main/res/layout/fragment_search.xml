<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Green search header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_green_bg"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <EditText
            android:id="@+id/searchbar_search_frag"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/searchbar_bg"
            android:drawableStart="@drawable/search"
            android:drawablePadding="10dp"
            android:hint="Search..."
            android:textColor="#333333"
            android:textColorHint="@color/grey"
            android:fontFamily="@font/rubik"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="text"
            android:imeOptions="actionSearch"/>

    </LinearLayout>

    <!-- Category chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/chip_all" android:layout_width="wrap_content" android:layout_height="32dp" android:text="All" android:textSize="13sp" android:fontFamily="@font/rubik" android:textColor="#FFFFFF" android:background="@drawable/date_selected_bg" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp"/>
            <TextView android:id="@+id/chip_general" android:layout_width="wrap_content" android:layout_height="32dp" android:text="General" android:textSize="13sp" android:fontFamily="@font/rubik" android:textColor="#333333" android:background="@drawable/date_unselected_bg" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/chip_cardiology" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Cardiology" android:textSize="13sp" android:fontFamily="@font/rubik" android:textColor="#333333" android:background="@drawable/date_unselected_bg" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/chip_eye" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Eye" android:textSize="13sp" android:fontFamily="@font/rubik" android:textColor="#333333" android:background="@drawable/date_unselected_bg" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/chip_neurology" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Neurology" android:textSize="13sp" android:fontFamily="@font/rubik" android:textColor="#333333" android:background="@drawable/date_unselected_bg" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/chip_dental" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Dental" android:textSize="13sp" android:fontFamily="@font/rubik" android:textColor="#333333" android:background="@drawable/date_unselected_bg" android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp" android:layout_marginStart="8dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Doctor list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/find_doctor_rv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_find_doctor"
        xmlns:tools="http://schemas.android.com/tools"/>

    <!-- Hidden back button for code compat -->
    <ImageButton
        android:id="@+id/back_btn_find_doc_lyt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
