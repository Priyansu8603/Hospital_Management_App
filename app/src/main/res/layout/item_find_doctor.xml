<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="72dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/doctor_one"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/name_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Sarah Johnson"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:fontFamily="@font/rubik"/>

            <TextView
                android:id="@+id/job_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiologist"
                android:textSize="13sp"
                android:textColor="@color/green"
                android:fontFamily="@font/rubik"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/green_dot"/>
                <TextView
                    android:id="@+id/hospital_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City Heart Hospital"
                    android:textSize="11sp"
                    android:textColor="@color/grey"
                    android:fontFamily="@font/rubik"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/experience_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8 yrs"
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:fontFamily="@font/rubik"/>

                <TextView
                    android:id="@+id/rating_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" ⭐ 4.8"
                    android:textSize="12sp"
                    android:textColor="@color/grey"
                    android:fontFamily="@font/rubik"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/pricing_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  ₹800"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:fontFamily="@font/rubik"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/green_dot"/>
                <TextView
                    android:id="@+id/availability_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Today"
                    android:textSize="11sp"
                    android:textColor="@color/green"
                    android:fontFamily="@font/rubik"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/book_now_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/btn_green_rounded"
            android:text="Book Now"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/rubik"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>