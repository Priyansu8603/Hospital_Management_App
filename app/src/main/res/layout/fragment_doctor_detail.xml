<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Top green header -->
    <LinearLayout
        android:id="@+id/topBar_Linear_lyt"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/top_green_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/back_btn_doc_detail_lyt"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/back_bg_btn"
                android:src="@drawable/baseline_arrow_back_ios_24"
                android:padding="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Doctor Details"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/rubik"/>

            <ImageButton
                android:id="@+id/heart_favourite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/back_bg_btn"
                android:src="@drawable/heart1"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Doctor image row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="100dp"
                android:layout_height="110dp"
                android:scaleType="centerCrop"
                android:src="@drawable/doctor_one"
                android:background="@drawable/back_bg_btn"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/name_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Sarah Johnson"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/rubik"/>

                <TextView
                    android:id="@+id/job_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiologist"
                    android:textColor="#DDFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/rubik"
                    android:layout_marginTop="2dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/green_dot"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="City Heart Hospital"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/rubik"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/green_dot"/>
                    <TextView
                        android:id="@+id/location_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Green Valley, New York"
                        android:textColor="#DDFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@font/rubik"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- White card overlapping header -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="185dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Stats card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/detail_cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Stats row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/profile"/>
                            <TextView
                                android:id="@+id/experience_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8 yrs Experience"
                                android:textSize="12sp"
                                android:textColor="#333333"
                                android:fontFamily="@font/rubik"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <RatingBar
                                android:id="@+id/ratingBar"
                                style="?android:attr/ratingBarStyleSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:progressTint="@color/gold"
                                android:rating="4.8"
                                android:stepSize="0.5"
                                android:isIndicator="true"/>
                            <TextView
                                android:id="@+id/rating_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.8"
                                android:textSize="12sp"
                                android:textColor="@color/green"
                                android:fontFamily="@font/rubik"
                                android:layout_marginStart="4dp"/>
                            <TextView
                                android:id="@+id/ReviewTxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" (463 reviews)"
                                android:textSize="11sp"
                                android:textColor="@color/grey"
                                android:fontFamily="@font/rubik"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/green_dot"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.5 km"
                                android:textSize="12sp"
                                android:textColor="#333333"
                                android:fontFamily="@font/rubik"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/desc_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Experienced cardiologist specializing in heart health, offering personalized care and advanced diagnostic services."
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="@font/rubik"
                        android:background="@drawable/card_light_bg"
                        android:padding="10dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Shimmer placeholder (hidden by default) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/cardViewShimmerView"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">
                <include layout="@layout/shimmer_layout"/>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tab_about"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About Doctor"
                        android:textSize="13sp"
                        android:fontFamily="@font/rubik"
                        android:textColor="@color/grey"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <TextView
                        android:id="@+id/tab_reviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reviews"
                        android:textSize="13sp"
                        android:fontFamily="@font/rubik"
                        android:textColor="@color/grey"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginStart="6dp"/>

                    <TextView
                        android:id="@+id/tab_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="13sp"
                        android:fontFamily="@font/rubik"
                        android:textColor="@color/grey"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginStart="6dp"/>

                    <TextView
                        android:id="@+id/tab_book"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book Appointment"
                        android:textSize="13sp"
                        android:fontFamily="@font/rubik"
                        android:textColor="@color/green"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginStart="6dp"/>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Booking section card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/count_patient_cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <!-- Date chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/date_today"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:textSize="13sp"
                                android:textColor="#FFFFFF"
                                android:fontFamily="@font/rubik"
                                android:background="@drawable/date_selected_bg"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"/>

                            <TextView
                                android:id="@+id/date_tomorrow"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tomorrow"
                                android:textSize="13sp"
                                android:textColor="#333333"
                                android:fontFamily="@font/rubik"
                                android:background="@drawable/date_unselected_bg"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:layout_marginStart="8dp"/>

                            <TextView
                                android:id="@+id/date_day3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fri 17 Apr"
                                android:textSize="13sp"
                                android:textColor="#333333"
                                android:fontFamily="@font/rubik"
                                android:background="@drawable/date_unselected_bg"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:layout_marginStart="8dp"/>

                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/date_label_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wed 16 Apr"
                        android:textSize="12sp"
                        android:textColor="@color/grey"
                        android:fontFamily="@font/rubik"
                        android:layout_marginTop="6dp"/>

                    <!-- Time slots grid row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:id="@+id/slot_0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="10:00 AM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                        <TextView
                            android:id="@+id/slot_1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="10:30 AM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                        <TextView
                            android:id="@+id/slot_2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="11:00 AM"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_selected_bg"/>

                        <TextView
                            android:id="@+id/slot_3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="11:30 AM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                        <TextView
                            android:id="@+id/slot_4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="12:30 PM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                    </LinearLayout>

                    <!-- Time slots grid row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/slot_5"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="01:30 PM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                        <TextView
                            android:id="@+id/slot_6"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="02:00 PM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                        <TextView
                            android:id="@+id/slot_7"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="02:30 PM"
                            android:textSize="12sp"
                            android:textColor="#333333"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unselected_bg"/>

                        <TextView
                            android:id="@+id/slot_8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No Slots"
                            android:textSize="11sp"
                            android:textColor="@color/grey"
                            android:fontFamily="@font/rubik"
                            android:gravity="center"
                            android:padding="8dp"
                            android:layout_margin="3dp"
                            android:background="@drawable/time_slot_unavailable_bg"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>

                    </LinearLayout>

                    <!-- Confirm button -->
                    <Button
                        android:id="@+id/confirm_btn"
                        android:layout_width="200dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/btn_green_rounded"
                        android:text="Confirm"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/rubik"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Review card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/profile"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="John D."
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#222222"
                                android:fontFamily="@font/rubik"/>

                            <RatingBar
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="?android:attr/ratingBarStyleSmall"
                                android:progressTint="@color/gold"
                                android:rating="5"
                                android:isIndicator="true"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 days ago"
                            android:textSize="12sp"
                            android:textColor="@color/grey"
                            android:fontFamily="@font/rubik"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Excellent doctor, very compassionate and thorough in her consultation."
                        android:textSize="13sp"
                        android:textColor="#444444"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="@font/rubik"/>

                    <!-- Second confirm button in reviews -->
                    <Button
                        android:id="@+id/totalPatient_txt"
                        android:layout_width="200dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/btn_green_rounded"
                        android:text="Confirm"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/rubik"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Hidden views kept for code compatibility -->
    <View android:id="@+id/ongoing_txt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <View android:id="@+id/progressBar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

